# Per-Dockerfile ignore. BuildKit looks for this file next to Dockerfile, with
# paths relative to the build context root (mobile_robot_navigation). It speeds
# up builds and keeps artifacts, weights, and secrets out of the image context.
**/.git
**/build
**/install
**/log
**/__pycache__
**/*.py[cod]
**/.pytest_cache

# Model weights (~600 MB) are mounted into detector, not baked into the image.
**/model_weights

# Secrets must not enter image layers; compose reads vlm.env as env_file.
**/*.env
!**/*.env.example

# Not needed for builds.
ar_project/docs
ar_project/deploy
