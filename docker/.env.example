# Скопируйте в .env (docker compose подхватывает его автоматически).
#   cp .env.example .env
ROS_DISTRO=jazzy
ROS_DOMAIN_ID=42
# rmw_fastrtps_cpp — без внешних зависимостей внутри compose-сети.
# Для боевого транспорта (Wi-Fi Pi↔edge) используется rmw_zenoh — см. deploy/transport/.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
