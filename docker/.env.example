# Скопируйте в .env (docker compose подхватывает его автоматически).
#   cp .env.example .env
# run.sh / run.ps1 делают это сами при первом запуске.
ROS_DISTRO=jazzy

# Домен ROS 2 для симуляционных профилей. ВНИМАНИЕ: на железном пути домен нигде не
# задаётся, то есть Pi и edge работают в домене 0. docker-compose.robot.yml поэтому
# подставляет 0, а не это значение — иначе консоль оказалась бы в другом графе.
ROS_DOMAIN_ID=42

# rmw_fastrtps_cpp — без внешних зависимостей внутри compose-сети.
# Для боевого транспорта (Wi-Fi Pi↔edge) используется rmw_zenoh — см. deploy/transport/
# и docker-compose.robot.yml, который переключает RMW сам.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Порты веб-интерфейсов на хосте. Публикуются ТОЛЬКО на 127.0.0.1 — у консоли по
# умолчанию нет аутентификации, а она умеет запускать робота. Для доступа с другой
# машины используйте проброс: ssh -L 8090:127.0.0.1:8090 <хост>.
#   CONSOLE_PORT   — сама консоль оператора (http://127.0.0.1:8090)
#   DASHBOARD_PORT — mission_dashboard; консоль и так проксирует его на /dashboard/,
#                    отдельный порт нужен только для отладки в обход консоли.
CONSOLE_PORT=8090
DASHBOARD_PORT=8088

# Адрес дашборда, который консоль проксирует на /dashboard/. В симуляции дашборд
# поднимается внутри контейнера console, поэтому 127.0.0.1. При подключении к реальному
# роботу значение перебивает docker-compose.robot.yml на http://$EDGE_HOST:8088.
DASHBOARD_URL=http://127.0.0.1:8088

# Токен консоли. ПУСТО = проверки нет (порты и так только на loopback). Если задать —
# консоль потребует заголовок X-Console-Token на все /api/* кроме GET /api/state.
# Это НЕ токен VLM: тот живёт только в object_tracking/planner_orchestrator/vlm.env.
CONSOLE_TOKEN=

# Адрес edge-бокса (GPU-машины рядом с роботом). Нужен ТОЛЬКО для подключения к
# реальному роботу: docker-compose.robot.yml делает исходящее TCP на tcp/$EDGE_HOST:7447
# (роутер zenoh) и берёт оттуда же дашборд на порту 8088.
EDGE_HOST=192.168.1.10

# Индекс колёс torch для сборки образов edge и full.
#   https://download.pytorch.org/whl/cu124 — NVIDIA до Ada включительно (по умолчанию)
#   https://download.pytorch.org/whl/cu128 — NVIDIA Blackwell: RTX 50xx (в т.ч.
#                                            RTX 5060 Ti), sm_120. ОБЯЗАТЕЛЬНО, см. ниже.
#   https://download.pytorch.org/whl/cpu   — машины без NVIDIA, в том числе Apple
#                                            Silicon; с cu124 сборка там просто упадёт.
# run.sh / run.ps1 подставляют cpu автоматически, если не нашли nvidia-smi.
#
# ПРО BLACKWELL (RTX 50xx). Колёса cu124 собраны под sm_50..sm_90, а у RTX 50xx
# вычислительная способность sm_120. Сборка образа проходит УСПЕШНО, контейнер
# стартует, torch.cuda.is_available() возвращает True — и только первая операция на
# устройстве падает с «CUDA error: no kernel image is available for execution on the
# device». Детектор выбирает устройство сам (yoloe_image_segmentation.py:55,
# 'cuda:0' если доступна CUDA, без возможности переключить параметром), поэтому на
# такой машине с cu124 верхний слой консоли нерабочий, хотя внешне всё «поднялось».
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
