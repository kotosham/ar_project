# Copy to .env; docker compose loads it automatically.
#   cp .env.example .env
ROS_DISTRO=jazzy
ROS_DOMAIN_ID=42
# rmw_fastrtps_cpp works inside the compose network without external deps.
# Production Wi-Fi transport (Pi-edge) uses rmw_zenoh; see deploy/transport/.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
