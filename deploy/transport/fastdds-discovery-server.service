# Fast DDS Discovery Server (FALLBACK transport) — ROADMAP Phase 1.1.
# Deploy on the EDGE host ONLY when falling back from rmw_zenoh to rmw_fastrtps.
# Mirrors the single-router topology: one discovery server instead of multicast.
#
# Install:
#   sudo cp fastdds-discovery-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now fastdds-discovery-server
# Clients set: ROS_DISCOVERY_SERVER="<edge-ip>:11811" (see transport_env.sh).
[Unit]
Description=Fast DDS Discovery Server (ROADMAP Phase 1.1 fallback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# server-id 0, listen on all interfaces, default discovery-server port 11811.
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && exec fastdds discovery -i 0 -l 0.0.0.0 -p 11811'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
