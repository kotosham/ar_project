// rmw_zenoh session (node) config — ROADMAP Phase 1.1.
//
// Deploy on EVERY host that runs ROS nodes (Pi executive + edge perception).
// Used by all rclcpp/rclpy processes when:
//   export RMW_IMPLEMENTATION=rmw_zenoh_cpp
//   export ZENOH_SESSION_CONFIG_URI=/etc/zenoh/zenoh_session_config.json5
// (see transport_env.sh).
//
// Replace EDGE_HOST with the edge router's IP/hostname. You can also override at
// runtime without editing this file:
//   export ZENOH_CONFIG_OVERRIDE='connect/endpoints=["tcp/192.168.1.10:7447"]'
// For a single-host smoke test, point connect at tcp/localhost:7447.
{
  mode: "client",

  // Multicast/gossip OFF for ROS nodes: every process connects only to the
  // single edge router below. Peer mode/gossip made Pi nodes try direct
  // process-to-process TCP links to edge nodes, which overloaded the robot
  // control side when edge_bringup started.
  scouting: {
    multicast: { enabled: false },
    gossip: { enabled: false },
  },

  // Required by rmw_zenoh's publication cache / advanced publishers. Without
  // this, some ROS 2 nodes can crash while creating publishers under rmw_zenoh.
  timestamping: {
    enabled: { router: true, peer: true, client: true },
    drop_future_timestamp: false,
  },

  // Connect to the single edge router. 12 MB TCP buffers per link (bounded by
  // net.core.{r,w}mem_max from 99-ros2-socket-buffers.conf).
  connect: {
    endpoints: [
      "tcp/EDGE_HOST:7447#so_sndbuf=12582912;so_rcvbuf=12582912",
    ],
  },
}
