# Pi/edge deploy config. Copy to deploy.env (gitignored) and fill in ONCE.
# Only PI_HOST / PI_USER are usually needed; the rest have sane defaults.

# --- Pi (robot) over SSH ---
PI_HOST=raspberrypi.local      # hostname or IP of the robot Pi
PI_USER=dende                  # ssh user on the Pi
PI_WS=/home/dende/ros2_ws      # colcon workspace on the Pi (created if absent)

# --- Edge (this GPU box) ---
EDGE_WS=/home/dende/ros2_ws    # colcon workspace on the edge box (where build_edge runs)

# --- common ---
ROS_DISTRO=jazzy

# Where the two source repos (ar_project, object_tracking) live on THIS machine.
# Leave blank to auto-detect (assumes they are siblings, which they are in this repo).
REPO_ROOT=
