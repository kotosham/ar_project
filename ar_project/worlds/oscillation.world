<!--
  Oscillation test world (ROADMAP 2.3 / must-fix #10).

  A central chamber (x in [-4,4], y in [-2,2]) with TWO symmetric 1.2 m openings,
  one on the east wall (x=+4) and one on the west wall (x=-4), equidistant from the
  spawn origin. Beyond each opening lies an equal unexplored bay bounded by an outer
  perimeter. The robot therefore faces two near-equal frontiers and the frontier
  extractor's hysteresis must NOT flip-flop between them. Symmetric about x=0.
-->
<sdf version="1.7">
  <world name="oscillation">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall macro is not available in plain SDF; walls are explicit boxes
         (size = L W H, thickness 0.1 m, height 0.5 m). -->

    <!-- Central chamber: full north/south walls (x in [-4,4]) -->
    <model name="chamber_north"><static>true</static><pose>0 2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 0.1 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="chamber_south"><static>true</static><pose>0 -2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 0.1 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- West wall at x=-4 with a 1.2 m gap centred on y=0 (left opening) -->
    <model name="west_upper"><static>true</static><pose>-4 1.3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 1.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 1.4 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="west_lower"><static>true</static><pose>-4 -1.3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 1.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 1.4 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- East wall at x=+4 with a symmetric 1.2 m gap (right opening) -->
    <model name="east_upper"><static>true</static><pose>4 1.3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 1.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 1.4 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="east_lower"><static>true</static><pose>4 -1.3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 1.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 1.4 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Outer perimeter (x in [-10,10], y in [-6,6]) bounding both bays -->
    <model name="perim_north"><static>true</static><pose>0 6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20 0.1 0.5</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>
    <model name="perim_south"><static>true</static><pose>0 -6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20 0.1 0.5</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>
    <model name="perim_west"><static>true</static><pose>-10 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 12 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 12 0.5</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>
    <model name="perim_east"><static>true</static><pose>10 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 12 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 12 0.5</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
  </world>
</sdf>
