<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Sim-only Gazebo sensors mounted on the TF frames defined by
         camera.xacro/depth_camera.xacro. Keep this separate so the real
         robot description only contains geometry and frame definitions. -->
    <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <!-- WSL2: gz OGRE2 sensor rendering is slow. RTAB-Map only runs at ~2 Hz,
                 so 640x480@30 just overwhelms the pipeline (multi-second lag breaks the
                 odom<->image sync -> crooked map). 320x240@15 (same 4:3 FOV) is plenty
                 and keeps RTAB-Map synced. visualize off to save GUI render cost. -->
            <visualize>false</visualize>
            <update_rate>$(arg cam_rate)</update_rate>
            <camera>
                <camera_info_topic>camera/camera/color/camera_info</camera_info_topic>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>$(arg cam_width)</width>
                    <height>$(arg cam_height)</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <!-- WHY the RGB far clip is 30 m while depth stays at 8 m:
                         a real colour camera sees clear across a room (and down a
                         15 m hallway), a RealSense depth sensor gives up at ~8 m.
                         Clipping BOTH at 8 m made the two sensors physically
                         identical and silently deleted the exact failure mode the
                         house benchmark has to reproduce: "the target is visible
                         in colour but there is no depth/lidar return for it".
                         Scenario s1 (target ~13 m down the hallway) is impossible
                         with an 8 m colour clip - the pixels simply never exist. -->
                    <far>$(arg cam_far)</far>
                </clip>
            </camera>
            <topic>camera/camera/color/image_raw</topic>
            <gz_frame_id>camera_link_optical</gz_frame_id>
        </sensor>
        <material>Gazebo/Red</material>
    </gazebo>

    <gazebo reference="camera_link">
        <sensor name="depth_camera" type="depth">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <!-- Must match the RGB sensor resolution+FOV so the aligned-depth emulation
                 (gz_bridge) keeps RGB and depth pixels coincident. That is why the
                 same cam_width/cam_height/cam_rate args drive both sensors: raising
                 the colour resolution without raising depth would break the pixel
                 correspondence RTAB-Map and the detector rely on. Only the far clip
                 differs - depth_far models the RealSense range limit. -->
            <visualize>false</visualize>
            <update_rate>$(arg cam_rate)</update_rate>
            <topic>camera/camera/depth/image_rect_raw</topic>
            <gz_frame_id>camera_link_optical</gz_frame_id>
            <camera>
                <camera_info_topic>camera/camera/depth/camera_info</camera_info_topic>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <width>$(arg cam_width)</width>
                    <height>$(arg cam_height)</height>
                </image>
                <!-- The clip that ACTUALLY limits the returned depth is this one, on
                     <camera>, not the <depth_camera><clip> below. Measured in gz-sim 8:
                     with the range only declared under <depth_camera>, a depth frame taken
                     from the west end of the hallway returned up to 14.13 m - the full
                     corridor - instead of stopping at 8. That silently destroys the whole
                     premise of scenario s1 ("visible in colour, no depth return"): the
                     planner would have a valid distance to a 12.6 m target and the
                     depth-gap case would never occur. Both are kept: this one is the one
                     that bites, <depth_camera><clip> stays as the declarative statement of
                     intent for any tool that reads it. -->
                <clip>
                    <near>0.05</near>
                    <far>$(arg depth_far)</far>
                </clip>
                <depth_camera>
                    <clip>
                        <near>0.05</near>
                        <!-- Stays short-range on purpose: /scan is derived from this
                             image by depthimage_to_laserscan (range_max 8.0), so
                             "beyond lidar range" == "farther than depth_far". -->
                        <far>$(arg depth_far)</far>
                    </clip>
                </depth_camera>
            </camera>
        </sensor>
    </gazebo>

</robot>
