<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ar_project</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="my_email@email.com">Josh Newans</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>lely_core_libraries</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>std_msgs</build_depend>

  <exec_depend>canopen</exec_depend>
  <exec_depend>canopen_402_driver</exec_depend>
  <exec_depend>canopen_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>depthimage_to_laserscan</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>lely_core_libraries</exec_depend>
  <exec_depend>ar_project_msgs</exec_depend>
  <exec_depend>fleet_comms</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <!-- Узлы Nav2, которые ПОИМЁННО запускают navigation_launch.py и
       collision_monitor.launch.py. Раньше здесь стоял только nav2_collision_monitor,
       и на машине, где Nav2 доставили руками, всё работало — а в образе, где состав
       пакетов определяет ТОЛЬКО rosdep по этому файлу, launch падал на первой же
       строке: "package 'nav2_lifecycle_manager' not found". Список должен совпадать
       с тем, что реально резолвится в launch/. -->
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <!-- ПЛАГИНЫ Nav2. Их грузит pluginlib ПО ИМЕНИ КЛАССА из config/nav2_params.yaml,
       поэтому ни один инструмент не выведет их автоматически — в package.xml они
       обязаны стоять руками, иначе сервер стартует и падает уже в configure():
       "Failed to create controller. Exception: ... class dwb_core::DWBLocalPlanner".
         dwb_core            — FollowPath: dwb_core::DWBLocalPlanner
         dwb_critics         — критики RotateToGoal/Oscillation/BaseObstacle/
                               GoalAlign/PathAlign/PathDist/GoalDist
         dwb_plugins         — генератор траекторий DWB
         nav2_navfn_planner  — GridBased: nav2_navfn_planner::NavfnPlanner
       smoother_server и waypoint_follower намеренно НЕ нужны: они выброшены из
       lifecycle_nodes в navigation_launch.py:44-50. -->
  <exec_depend>dwb_core</exec_depend>
  <exec_depend>dwb_critics</exec_depend>
  <exec_depend>dwb_plugins</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclcpp_lifecycle</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>rtabmap_msgs</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rtabmap_launch</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>
