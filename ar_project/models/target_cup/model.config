<?xml version="1.0"?>
<model>
  <name>target_cup</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>Static bright-red floor cup (r 0.045, h 0.11, plus a handle) used as the
  open-vocab "cup" search target. Kept low because my_bot's camera sits at z = 0.13 m,
  and static so repeated episodes stay byte-for-byte comparable.</description>
</model>
