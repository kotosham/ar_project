<?xml version="1.0"?>
<model>
  <name>target_bottle</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>Static bright-green floor bottle (body cylinder r 0.035 h 0.20 plus a
  r 0.015 h 0.07 neck) used as the open-vocab "bottle" target and as the colour-distinct
  distractor next to target_cup. Static for reproducible episodes, low because the
  robot camera sits at z = 0.13 m.</description>
</model>
