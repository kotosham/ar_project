<?xml version="1.0"?>
<model>
  <name>target_chair</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>
    Teal chair used as the long-range mission target in the house benchmark
    (s1_far_target). Sized so it is still ~18x36 px at 12.6 m, which is what makes
    "visible in colour, absent from depth" a real scenario rather than an empty
    corridor. Static.
  </description>
</model>
