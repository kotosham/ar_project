<?xml version="1.0"?>
<model>
  <name>sign_cup_kitchen</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>Static instruction board (1.60 x 0.05 x 0.90, centre z 0.60, on two legs)
  textured with the bilingual "КРУЖКА - НА КУХНЕ / CUP -&gt; KITCHEN" sign. Deliberately low
  so the whole printed face fits the 320x240 frame of a camera mounted at z = 0.13 m.</description>
</model>
