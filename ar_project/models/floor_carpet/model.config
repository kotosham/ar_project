<?xml version="1.0"?>
<model>
  <name>floor_carpet</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>Static brown-red floor mat 2.00 x 1.60 x 0.020 (centre z 0.010) with
  ODE friction mu = mu2 = 1.6. The disturbance it injects is the 2 cm lip the 0.038 m
  wheels must climb, not the friction; the high mu only makes the mat grip once the
  robot is on it.</description>
</model>
