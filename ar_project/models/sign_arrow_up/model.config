<?xml version="1.0"?>
<model>
  <name>sign_arrow_up</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>Static wayfinding board (1.60 x 0.05 x 0.90, centre z 0.60, on two legs)
  textured with a solid up ("straight ahead") arrow and "ВАННАЯ / BATHROOM". Same geometry
  as the other sign_* models, only the albedo_map differs; kept low for the 0.13 m
  camera.</description>
</model>
