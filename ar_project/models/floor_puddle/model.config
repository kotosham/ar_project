<?xml version="1.0"?>
<model>
  <name>floor_puddle</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>Static semi-transparent blue-grey patch 1.40 x 1.20 x 0.004 (centre z 0.002)
  with ODE friction mu = mu2 = 0.02. Flush with the floor on purpose: the low mu is the
  disturbance (wheels slip, odometry diverges), unlike floor_carpet whose 2 cm lip is the
  disturbance.</description>
</model>
