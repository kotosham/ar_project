<?xml version="1.0"?>
<model>
  <name>clutter_pile</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>Static brown pile of three boxes (0.40x0.30x0.30, 0.30x0.25x0.25,
  0.25x0.25x0.45) spawned into doorways and hallway lanes to block the shortest path and
  force a replan. Static so the robot cannot bulldoze it and break reproducibility.</description>
</model>
