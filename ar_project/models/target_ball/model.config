<?xml version="1.0"?>
<model>
  <name>target_ball</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>Static bright-orange sphere (r 0.11, resting on the floor) used as the
  open-vocab "sports ball" target for the beyond-8 m depth-gap scenario. Static so it
  cannot roll out of the oracle's near_xy check; sized so it sits at the robot camera's
  0.13 m eye level.</description>
</model>
