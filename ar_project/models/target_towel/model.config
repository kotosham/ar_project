<?xml version="1.0"?>
<model>
  <name>target_towel</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>Static bright-yellow slab 0.30 x 0.06 x 0.40 (centre z 0.20) standing in for a
  hanging towel, the open-vocab "towel" target of the bathroom-inference and occlusion
  scenarios. Deliberately floor-level because my_bot's camera is only 0.13 m up.</description>
</model>
