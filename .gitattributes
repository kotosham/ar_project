# Файлы, исполняемые в Linux / Docker-контейнерах, ВСЕГДА с LF.
# На Windows git иначе ставит CRLF, и CRLF в shebang ломает запуск (bad interpreter),
# а CRLF в Dockerfile/compose даёт трудноуловимые ошибки сборки.
*.sh                text eol=lf
*.bash              text eol=lf
entrypoint.sh       text eol=lf
Dockerfile          text eol=lf
*.dockerignore      text eol=lf
docker-compose*.yml text eol=lf
*.ps1               text eol=crlf
Makefile            text eol=lf
*.service           text eol=lf
*.conf              text eol=lf
*.json5             text eol=lf
